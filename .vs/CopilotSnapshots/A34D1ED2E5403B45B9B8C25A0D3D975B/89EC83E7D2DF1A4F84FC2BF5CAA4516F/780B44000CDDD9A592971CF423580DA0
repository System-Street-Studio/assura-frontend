:host {
  display: block;
}

.page {
  padding: 28px 32px;
  font-family: 'Jost', sans-serif;
}

.page-title {
  font-size: 1.6rem;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 20px;
}

/* KPI row */
.kpi-row {
  display: flex;
  gap: 18px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.kpi-card {
  flex: 1;
  min-width: 180px;
  background: white;
  border-radius: 12px;
  padding: 18px 20px;
  box-shadow: 0 4px 12px rgba(9, 61, 54, 0.05);
  border: 1px solid rgba(6, 71, 71, 0.06);
  display: flex;
  align-items: center;
  gap: 14px;
  transition: transform 0.15s, box-shadow 0.15s;
}

.kpi-card.clickable {
  cursor: pointer;
}

.kpi-card.clickable:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(9, 61, 54, 0.1);
}

.kpi-icon-wrap {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.kpi-icon-wrap mat-icon {
  font-size: 22px;
  width: 22px;
  height: 22px;
  color: #fff;
}

.kpi-icon-wrap.blue { background: #0b6c78; }
.kpi-icon-wrap.orange { background: #e8860c; }
.kpi-icon-wrap.red { background: #d93025; }
.kpi-icon-wrap.teal { background: #2f9a6b; }

.kpi-info .label {
  font-size: 13px;
  color: #6b7b7b;
}

.kpi-info .value {
  font-size: 22px;
  font-weight: 700;
  margin-top: 2px;
  color: #1a1a1a;
}

/* Charts grid */
.charts-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  margin-bottom: 24px;
}

.card {
  background: white;
  border-radius: 10px;
  padding: 14px;
  min-height: 260px;
  box-shadow: 0 6px 12px rgba(9, 61, 54, 0.04);
  border: 1px solid rgba(6, 71, 71, 0.04);
}

.card-title {
  font-weight: 600;
  margin-bottom: 12px;
  color: #1a1a1a;
}

.chart-area {
  height: 200px;
}

/* Anomalies */
.anomalies {
  margin-top: 12px;
}

.section-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 12px;
}

.anomaly-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.anomaly-card {
  background: white;
  border-radius: 10px;
  padding: 12px 16px;
  min-width: 320px;
  flex: 1;
  display: flex;
  gap: 12px;
  align-items: center;
  border: 1px solid rgba(6, 71, 71, 0.04);
  box-shadow: 0 4px 8px rgba(9, 61, 54, 0.03);
}

.anomaly-card .icon {
  font-size: 20px;
}

.anomaly-card .text {
  font-weight: 600;
  color: #1a1a1a;
}

/* Responsive */
@media (max-width: 900px) {
  .charts-grid {
    grid-template-columns: 1fr;
  }
}
