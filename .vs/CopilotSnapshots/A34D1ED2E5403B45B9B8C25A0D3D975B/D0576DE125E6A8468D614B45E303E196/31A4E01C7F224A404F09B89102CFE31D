:host {
    display: block;
    height: 100%;
}

.shell-layout {
    display: flex;
    height: 100vh;
    width: 100%;
    overflow: hidden;
}

.main-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.content {
    flex: 1;
    padding: 16px;
    overflow-y: auto;
}