:host {
  display: block;
  height: 100%;
}

.sidebar {
  width: 240px;
  height: 100%;
  background: linear-gradient(180deg, #d5f5f5 0%, #c8efef 100%);
  display: flex;
  flex-direction: column;
  padding: 0;
  transition: width 0.22s ease;
  border-right: 1px solid rgba(0, 0, 0, 0.04);
}

.sidebar.collapsed {
  width: 64px;
}

/* Header */
.sidebar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  height: 56px;
  box-sizing: border-box;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.sidebar-logo {
  height: 28px;
  width: 28px;
  object-fit: contain;
}

.sidebar-title {
  font-family: 'Jost', sans-serif;
  font-size: 1.5rem;
  font-weight: 700;
  color: #004777;
}

.menu-toggle {
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  color: #023435;
  border-radius: 6px;
}

.menu-toggle:hover {
  background: rgba(0, 0, 0, 0.06);
}

/* Main nav */
.sidebar-nav {
  display: flex;
  flex-direction: column;
  padding: 8px 10px;
  overflow-y: auto;
  flex: 1;
  gap: 2px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  text-decoration: none;
  color: #044b4b;
  font-family: 'Jost', sans-serif;
  font-size: 0.95rem;
  cursor: pointer;
  border-radius: 8px;
  transition: background 0.2s ease, color 0.15s ease;
  box-sizing: border-box;
}

.nav-item:hover {
  background: rgba(11, 108, 120, 0.1);
}

.nav-item.active {
  background: linear-gradient(90deg, #0b6c78, #075a5a);
  color: #ffffff;
  box-shadow: 0 6px 14px rgba(6, 71, 71, 0.12);
}

.nav-item.active .nav-icon {
  color: #ffffff;
}

.nav-icon {
  font-size: 1.2rem;
  width: 28px;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  color: #043838;
}

.nav-label {
  font-weight: 400;
}

/* Bottom section */
.sidebar-bottom {
  padding: 8px 10px;
  border-top: 1px solid rgba(0, 0, 0, 0.06);
}

.sidebar-footer {
  padding: 12px 14px 8px;
  font-family: 'Jost', sans-serif;
  font-size: 12px;
  color: rgba(0, 0, 0, 0.5);
}

/* Collapsed states */
.sidebar.collapsed .sidebar-header {
  justify-content: center;
  padding: 14px 8px;
}

.sidebar.collapsed .menu-toggle {
  margin: 0;
}

.sidebar.collapsed .sidebar-nav,
.sidebar.collapsed .sidebar-bottom {
  padding: 8px 6px;
}

.sidebar.collapsed .nav-item {
  justify-content: center;
  padding: 10px 6px;
}

/* Responsive */
@media (max-width: 620px) {
  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 50;
  }
}
