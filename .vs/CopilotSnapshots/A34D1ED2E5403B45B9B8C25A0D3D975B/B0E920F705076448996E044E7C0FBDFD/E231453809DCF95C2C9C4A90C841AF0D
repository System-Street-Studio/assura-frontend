<nav class="navbar">
  <!-- Left: Role badge -->
  <div class="navbar-left">
    <span class="role-badge">
      <mat-icon class="role-icon">shield</mat-icon>
      {{ roleName }}
    </span>
  </div>

  <!-- Right: Notifications + Profile -->
  <div class="navbar-right">
    <!-- Notification bell -->
    <div class="notif-wrapper">
      <button class="icon-btn" (click)="toggleNotifications()" aria-label="Notifications">
        <mat-icon>notifications</mat-icon>
        <span class="notif-badge" *ngIf="unreadCount > 0">{{ unreadCount }}</span>
      </button>

      <!-- Notification dropdown -->
      <div class="notif-panel" *ngIf="showNotifPanel">
        <div class="notif-header">
          <span class="notif-title">Notifications</span>
          <button class="mark-all-btn" (click)="markAllRead()" *ngIf="unreadCount > 0">
            Mark all as read
          </button>
        </div>

        <div class="notif-list" *ngIf="notifications.length > 0">
          <div
            class="notif-item"
            *ngFor="let n of notifications"
            [class.unread]="!n.read"
            (click)="markAsRead(n)"
          >
            <div class="notif-icon-wrap" [ngClass]="n.type">
              <mat-icon class="notif-icon">{{ n.icon }}</mat-icon>
            </div>
            <div class="notif-body">
              <span class="notif-item-title">{{ n.title }}</span>
              <span class="notif-msg">{{ n.message }}</span>
              <span class="notif-time">{{ getTimeAgo(n.timestamp) }}</span>
            </div>
            <span class="unread-dot" *ngIf="!n.read"></span>
          </div>
        </div>

        <div class="notif-empty" *ngIf="notifications.length === 0">
          <mat-icon class="empty-bell">notifications_off</mat-icon>
          <span>No notifications</span>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="nav-divider"></div>

    <!-- Profile -->
    <div class="profile-wrapper">
      <button class="profile-trigger" (click)="toggleProfileMenu()">
        <span class="avatar">{{ initials }}</span>
        <div class="profile-info">
          <span class="profile-name">{{ employeeName }}</span>
          <span class="profile-role">{{ roleName }}</span>
        </div>
        <mat-icon class="chevron" [class.open]="showProfileMenu">expand_more</mat-icon>
      </button>

      <!-- Profile dropdown -->
      <div class="profile-menu" *ngIf="showProfileMenu">
        <button class="menu-item" (click)="onProfile()">
          <mat-icon>person</mat-icon>
          Profile
        </button>
        <button class="menu-item" (click)="onSettings()">
          <mat-icon>settings</mat-icon>
          Settings
        </button>
        <div class="menu-divider"></div>
        <button class="menu-item logout" (click)="onLogout()">
          <mat-icon>logout</mat-icon>
          Sign Out
        </button>
      </div>
    </div>
  </div>
</nav>
