:host {
  display: block;
}

.asset-form-page {
  padding: 28px 32px;
  font-family: 'Jost', sans-serif;
}

/* ── Back link ── */
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: none;
  border: none;
  color: #0b6c78;
  font-family: 'Jost', sans-serif;
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  padding: 0;
  margin-bottom: 18px;
  transition: color 0.15s;
}

.back-link:hover {
  color: #094e57;
}

.back-link mat-icon {
  font-size: 18px;
  width: 18px;
  height: 18px;
}

/* ── Header ── */
.form-header h2 {
  font-size: 1.5rem;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 24px;
}

/* ── Form grid ── */
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 32px;
}

.form-col {
  display: flex;
  flex-direction: column;
}

.form-full {
  grid-column: 1 / -1;
}

.form-actions {
  grid-column: 1 / -1;
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 24px;
  padding-top: 20px;
  border-top: 1px solid #e6eef0;
}

/* ── Form group ── */
.form-group {
  margin-bottom: 18px;
}

.form-group label {
  display: block;
  font-size: 0.82rem;
  font-weight: 600;
  color: #7d8b8c;
  margin-bottom: 6px;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 10px 14px;
  border-radius: 8px;
  border: 1px solid #dce6e6;
  font-family: 'Jost', sans-serif;
  font-size: 0.9rem;
  outline: none;
  background: white;
  color: #1a1a1a;
  transition: border-color 0.15s;
  box-sizing: border-box;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: #0b6c78;
  box-shadow: 0 0 0 3px rgba(11, 108, 120, 0.08);
}

.form-group textarea {
  resize: vertical;
  min-height: 80px;
}

/* ── Validation error state ── */
.form-group.has-error input,
.form-group.has-error select {
  border-color: #d93025;
}

.form-group.has-error input:focus,
.form-group.has-error select:focus {
  box-shadow: 0 0 0 3px rgba(217, 48, 37, 0.1);
}

.form-group.has-error label {
  color: #d93025;
}

.error-text {
  display: block;
  font-size: 0.78rem;
  color: #d93025;
  margin-top: 4px;
}

/* ── Buttons ── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 20px;
  border-radius: 8px;
  font-family: 'Jost', sans-serif;
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s;
  border: 1px solid #dce6e6;
  background: white;
}

.btn:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.btn.primary {
  background: #0b6c78;
  color: white;
  border: none;
  box-shadow: 0 2px 8px rgba(11, 108, 120, 0.2);
}

.btn.primary:hover:not(:disabled) {
  background: #095a64;
}

.btn.outline:hover {
  border-color: #0b6c78;
  color: #0b6c78;
}

.btn-icon {
  font-size: 17px;
  width: 17px;
  height: 17px;
}

.spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  100% {
    transform: rotate(360deg);
  }
}

/* ── Responsive ── */
@media (max-width: 720px) {
  .form-grid {
    grid-template-columns: 1fr;
  }
}
