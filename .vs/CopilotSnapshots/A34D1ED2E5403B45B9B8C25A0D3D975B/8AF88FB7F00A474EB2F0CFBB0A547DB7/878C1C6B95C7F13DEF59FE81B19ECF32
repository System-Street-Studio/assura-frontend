:host {
  display: block;
}

.page {
  padding: 24px 28px;
  font-family: 'Jost', sans-serif;
}

/* ── Welcome Banner ── */
.welcome-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #0b6c78 0%, #0a5a64 100%);
  border-radius: 14px;
  padding: 28px 32px;
  margin-bottom: 24px;
  color: #fff;
}

.welcome-title {
  font-size: 1.5rem;
  font-weight: 700;
  margin: 0 0 4px;
}

.welcome-sub {
  font-size: 0.9rem;
  opacity: 0.82;
  margin: 0;
}

.quick-actions {
  display: flex;
  gap: 10px;
}

.quick-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 20px;
  border-radius: 8px;
  font-size: 0.88rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.15s;
  cursor: pointer;
  font-family: 'Jost', sans-serif;
}

.quick-btn mat-icon {
  font-size: 18px;
  width: 18px;
  height: 18px;
}

.quick-btn.primary {
  background: #fff;
  color: #0b6c78;
}

.quick-btn.primary:hover {
  background: #e6f7f7;
}

.quick-btn.outline {
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.35);
}

.quick-btn.outline:hover {
  background: rgba(255, 255, 255, 0.25);
}

/* ── KPI Grid ── */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 14px;
  margin-bottom: 24px;
}

.kpi-card {
  background: #fff;
  border-radius: 12px;
  padding: 18px 16px;
  box-shadow: 0 2px 8px rgba(9, 61, 54, 0.04);
  border: 1px solid rgba(6, 71, 71, 0.06);
  transition: transform 0.15s, box-shadow 0.15s;
}

.kpi-card.clickable {
  cursor: pointer;
}

.kpi-card.clickable:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(9, 61, 54, 0.1);
}

.kpi-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.kpi-icon-wrap {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kpi-icon-wrap mat-icon {
  font-size: 20px;
  width: 20px;
  height: 20px;
  color: #fff;
}

.kpi-icon-wrap.teal { background: #0b6c78; }
.kpi-icon-wrap.blue { background: #3b82f6; }
.kpi-icon-wrap.green { background: #19a974; }
.kpi-icon-wrap.purple { background: #6366f1; }
.kpi-icon-wrap.orange { background: #f59e0b; }
.kpi-icon-wrap.red { background: #ef4444; }

.kpi-trend {
  font-size: 18px !important;
  width: 18px !important;
  height: 18px !important;
}

.kpi-trend.up { color: #19a974; }
.kpi-trend.down { color: #ef4444; }
.kpi-trend.neutral { color: #9ca3af; }

.kpi-value {
  font-size: 1.5rem;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1;
  margin-bottom: 4px;
}

.kpi-label {
  font-size: 0.8rem;
  color: #6b7b7b;
}

/* ── Two Column Layout ── */
.two-column {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin-bottom: 24px;
}

.panel {
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(9, 61, 54, 0.04);
  border: 1px solid rgba(6, 71, 71, 0.06);
  overflow: hidden;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px 12px;
  border-bottom: 1px solid #f0f4f4;
}

.panel-title {
  font-size: 0.95rem;
  font-weight: 600;
  color: #1a1a1a;
  margin: 0;
  display: flex;
  align-items: center;
  gap: 6px;
}

.panel-title mat-icon {
  font-size: 18px;
  width: 18px;
  height: 18px;
  color: #6b7b7b;
}

.panel-link {
  font-size: 0.8rem;
  color: #0b6c78;
  text-decoration: none;
  font-weight: 500;
}

.panel-link:hover {
  text-decoration: underline;
}

.panel-badge {
  font-size: 0.75rem;
  background: #fef3cd;
  color: #856404;
  padding: 3px 10px;
  border-radius: 20px;
  font-weight: 500;
}

/* ── Activity Feed ── */
.activity-list {
  max-height: 340px;
  overflow-y: auto;
}

.activity-item {
  display: flex;
  gap: 12px;
  padding: 12px 20px;
  border-bottom: 1px solid #f7f9f9;
  transition: background 0.1s;
}

.activity-item:last-child {
  border-bottom: none;
}

.activity-item:hover {
  background: #f9fbfb;
}

.activity-icon {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.activity-icon mat-icon {
  font-size: 18px;
  width: 18px;
  height: 18px;
}

.activity-body {
  flex: 1;
  min-width: 0;
}

.activity-main {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.85rem;
}

.activity-main strong {
  color: #1a1a1a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.activity-action {
  color: #6b7b7b;
  font-size: 0.8rem;
}

.activity-meta {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 0.75rem;
  color: #9ca3af;
  margin-top: 2px;
}

.activity-id {
  font-family: monospace;
  font-size: 0.72rem;
}

.activity-sep {
  color: #d1d5db;
}

.activity-time {
  color: #0b6c78;
  font-weight: 500;
}

/* ── Warranty Alerts ── */
.warranty-list {
  max-height: 340px;
  overflow-y: auto;
}

.warranty-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 20px;
  border-bottom: 1px solid #f7f9f9;
  transition: background 0.1s;
}

.warranty-item:last-child {
  border-bottom: none;
}

.warranty-item:hover {
  background: #f9fbfb;
}

.warranty-item.severity-critical {
  border-left: 3px solid #ef4444;
}

.warranty-item.severity-warning {
  border-left: 3px solid #f59e0b;
}

.warranty-item.severity-info {
  border-left: 3px solid #3b82f6;
}

.warranty-name {
  font-size: 0.85rem;
  font-weight: 600;
  color: #1a1a1a;
}

.warranty-meta {
  font-size: 0.75rem;
  color: #9ca3af;
  margin-top: 2px;
}

.warranty-right {
  text-align: right;
  flex-shrink: 0;
}

.warranty-badge {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 12px;
  font-size: 0.72rem;
  font-weight: 600;
}

.warranty-badge.critical {
  background: #fef2f2;
  color: #dc2626;
}

.warranty-badge.warning {
  background: #fffbeb;
  color: #d97706;
}

.warranty-badge.info {
  background: #eff6ff;
  color: #2563eb;
}

.warranty-date {
  font-size: 0.7rem;
  color: #9ca3af;
  margin-top: 2px;
}

/* ── Charts Grid ── */
.charts-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  margin-bottom: 24px;
}

.card {
  background: #fff;
  border-radius: 12px;
  padding: 18px;
  min-height: 280px;
  box-shadow: 0 2px 8px rgba(9, 61, 54, 0.04);
  border: 1px solid rgba(6, 71, 71, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.card-title {
  font-weight: 600;
  color: #1a1a1a;
  font-size: 0.95rem;
}

.card-icon {
  font-size: 18px !important;
  width: 18px !important;
  height: 18px !important;
  color: #9ca3af;
}

.chart-area {
  height: 210px;
}

/* ── Anomalies ── */
.anomalies {
  margin-bottom: 12px;
}

.section-title {
  font-size: 1rem;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 14px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.section-title mat-icon {
  font-size: 20px;
  width: 20px;
  height: 20px;
  color: #f59e0b;
}

.anomaly-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.anomaly-card {
  background: #fff;
  border-radius: 12px;
  padding: 18px 20px;
  display: flex;
  gap: 14px;
  align-items: flex-start;
  box-shadow: 0 2px 8px rgba(9, 61, 54, 0.04);
}

.anomaly-card.critical {
  border-left: 3px solid #ef4444;
}

.anomaly-card.warning {
  border-left: 3px solid #f59e0b;
}

.anomaly-card.info {
  border-left: 3px solid #3b82f6;
}

.anomaly-icon-wrap {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.anomaly-icon-wrap mat-icon {
  font-size: 20px;
  width: 20px;
  height: 20px;
}

.anomaly-icon-wrap.critical-bg {
  background: #fef2f2;
}

.anomaly-icon-wrap.critical-bg mat-icon {
  color: #ef4444;
}

.anomaly-icon-wrap.warning-bg {
  background: #fffbeb;
}

.anomaly-icon-wrap.warning-bg mat-icon {
  color: #f59e0b;
}

.anomaly-icon-wrap.info-bg {
  background: #eff6ff;
}

.anomaly-icon-wrap.info-bg mat-icon {
  color: #3b82f6;
}

.anomaly-body {
  flex: 1;
}

.anomaly-value {
  font-size: 1.4rem;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1;
  margin-bottom: 4px;
}

.anomaly-label {
  font-size: 0.78rem;
  color: #6b7b7b;
  line-height: 1.3;
}

/* ── Responsive ── */
@media (max-width: 1200px) {
  .kpi-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 900px) {
  .welcome-banner {
    flex-direction: column;
    gap: 16px;
    text-align: center;
  }

  .kpi-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .two-column {
    grid-template-columns: 1fr;
  }

  .charts-grid {
    grid-template-columns: 1fr;
  }

  .anomaly-row {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .page {
    padding: 16px;
  }

  .kpi-grid {
    grid-template-columns: 1fr;
  }

  .quick-actions {
    flex-direction: column;
    width: 100%;
  }

  .quick-btn {
    justify-content: center;
  }
}

/* ── Loading Skeleton ── */
.skeleton-banner {
  height: 100px;
  border-radius: 14px;
  margin-bottom: 24px;
  background: linear-gradient(90deg, #eef3f3 25%, #f8fafa 50%, #eef3f3 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}

.skeleton-card {
  min-height: 90px;
}

.skeleton-chart {
  min-height: 280px;
}

.skeleton-line {
  height: 14px;
  border-radius: 6px;
  background: linear-gradient(90deg, #eef3f3 25%, #f8fafa 50%, #eef3f3 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}

.skeleton-line.short {
  width: 60%;
  margin-bottom: 10px;
}

.skeleton-line.wide {
  width: 40%;
  height: 22px;
}

.skeleton-block {
  height: 180px;
  border-radius: 8px;
  margin-top: 12px;
  background: linear-gradient(90deg, #eef3f3 25%, #f8fafa 50%, #eef3f3 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
