import { Component, OnInit, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { RouterLink } from '@angular/router';
import { MatIconModule } from '@angular/material/icon';
import { BaseChartDirective } from 'ng2-charts';
import { ChartConfiguration, ChartOptions } from 'chart.js';
import { forkJoin } from 'rxjs';
import { DashboardService } from '../../services/dashboard.service';
import { Kpi, ChartDatasets } from '../../models/dashboard.model';
import { ToastService } from '../../../../shared/services/toast.service';

@Component({
  selector: 'app-dashboard',
  standalone: true,
  imports: [CommonModule, RouterLink, MatIconModule, BaseChartDirective],
  templateUrl: './dashboard.html',
  styleUrls: ['./dashboard.css'],
})
export class DashboardComponent implements OnInit {
private svc = inject(DashboardService);
private toast = inject(ToastService);

loading = true;
kpis: Kpi = { totalAssets: 0, ghostAssets: 0, missingAssets: 0, totalAssetValue: '$0' };
  charts!: ChartDatasets;

  doughnutData!: ChartConfiguration<'doughnut'>['data'];
  doughnutOptions: ChartOptions<'doughnut'> = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { position: 'right', labels: { boxWidth: 12 } } },
  };

  barOptions: ChartOptions<'bar'> = {
    responsive: true,
    maintainAspectRatio: false,
    scales: {
      x: { ticks: { color: '#333' } },
      y: { ticks: { color: '#333' } },
    },
    plugins: { legend: { display: false } },
  };

  assetsByStatusData!: ChartConfiguration<'bar'>['data'];
  assetsByDepartmentData!: ChartConfiguration<'bar'>['data'];
  assetValueByCategoryData!: ChartConfiguration<'bar'>['data'];

  anomalies = { ghostAssets: 0, missingAssets: 0 };

  ngOnInit(): void {
    forkJoin({
      kpis: this.svc.getKpis(),
      charts: this.svc.getCharts(),
    }).subscribe({
      next: ({ kpis, charts }) => {
        this.kpis = kpis;
        this.charts = charts;
        this.prepareCharts();
        this.anomalies = charts.anomalies;
        this.loading = false;
      },
      error: () => {
        this.loading = false;
        this.toast.error('Failed to load dashboard data');
      },
    });
  }

  private prepareCharts(): void {
    this.doughnutData = {
      labels: this.charts.assetsByCategory.labels,
      datasets: [
        {
          data: this.charts.assetsByCategory.data,
          backgroundColor: this.charts.assetsByCategory.colors,
          hoverOffset: 8,
        },
      ],
    };

    this.assetsByStatusData = {
      labels: this.charts.assetsByStatus.labels,
      datasets: [
        {
          data: this.charts.assetsByStatus.data,
          backgroundColor: this.charts.assetsByStatus.colors,
        },
      ],
    };

    this.assetsByDepartmentData = {
      labels: this.charts.assetsByDepartment.labels,
      datasets: [
        {
          data: this.charts.assetsByDepartment.data,
          backgroundColor: this.charts.assetsByDepartment.colors,
        },
      ],
    };

    this.assetValueByCategoryData = {
      labels: this.charts.assetValueByCategory.labels,
      datasets: [
        {
          data: this.charts.assetValueByCategory.data,
          backgroundColor: this.charts.assetValueByCategory.colors,
        },
      ],
    };
  }
}
